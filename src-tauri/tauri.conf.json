{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Another",
  "version": "1.0.0",
  "identifier": "com.chizi.another",
  "build": {
    "beforeDevCommand": "bash scripts/build-cli.sh debug && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/build-cli.sh release && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Another",
        "width": 1120,
        "height": 760,
        "resizable": true,
        "minWidth": 720,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "label": "main",
        "trafficLightPosition": {
          "x": 28,
          "y": 28
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "another"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/Zfinix/another/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwOUM2QkMzM0RFNDdCRjkKUldUNWUrUTl3MnVjd1Azb0k5Rm9MQXphVGJzaHdRNC9IZVhQazZTN2xUay8wQkdBZjBjL1o3R2kK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application",
      "minimumSystemVersion": "10.15"
    },
    "externalBin": [
      "binaries/another-cli"
    ]
  }
}
