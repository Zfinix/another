{
  "name": "tauri-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:dmg": "dotenv -- tauri build --bundles dmg",
    "publish:dmg": "dotenv -- tauri build --bundles dmg && gh release upload v$(node -p \"require('./package.json').version\") src-tauri/target/release/bundle/dmg/*.dmg --clobber"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^7.0.4"
  }
}
